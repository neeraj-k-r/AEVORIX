{
  "name": "aevorix",
  "version": "1.0.0",
  "description": "AEVORIX - Centralized EHR Platform with RBAC, Blockchain, XAI & RAG",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "echo 'Backend uses Node.js directly'",
    "install:all": "npm install && npm install --workspaces",
    "schema": "echo 'Run backend/schema.sql in Supabase SQL Editor'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}