# AEVORIX AI Service Environment Variables
# Copy to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Supabase (for fetching patient data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API (for LLM responses)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.3

# Risk Model Configuration
RISK_MODEL_VERSION=v1.0
RISK_FEATURES=hba1c,hypertension,diabetes,egfr,age,bmi,medication_adherence

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000